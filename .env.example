APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# IRAD identity source. Both drivers resolve people.person_code.
# Local development: development
# Production with ADFS: adfs
IRAD_IDENTITY_DRIVER=development

# Local development identity override.
DEV_USER_ENABLED=true
DEV_PERSON_CODE=1111111

# Production ADFS identity.
# IMPORTANT: production must set IRAD_IDENTITY_DRIVER=adfs.
# This source must be the exact trusted SERVER variable populated by the
# ADFS/web-server integration with IRAD's people.person_code value.
# Do not use an arbitrary client-supplied header unless the trusted web server
# strips incoming copies and injects the authenticated claim itself.
IRAD_ADFS_PERSON_CODE_SOURCE=HTTP_PERSON_CODE
# Deployment and gateway requirements: docs/INSITE_IDENTITY_INTEGRATION.md

# Initial installation only. Enable temporarily when enterprise identity is
# not yet available, run `php artisan app:bootstrap-owner`, configure the app,
# then complete setup in the UI. The installation-complete database state
# prevents this from becoming an ADFS fallback later.
IRAD_BOOTSTRAP_LOGIN_ENABLED=false
IRAD_BOOTSTRAP_OWNER_PERSON_CODE=1111111

# User Event Log: 0 keeps events indefinitely.
USER_EVENT_LOG_RETENTION_DAYS=0

# IRAD field-level data encryption.
# Laravel native authenticated encryption is the default provider.
IRAD_ENCRYPTION_DRIVER=laravel
IRAD_ENCRYPTION_KEY_VERSION=1
# Set a separate, long random secret in production. Keep it stable across APP_KEY rotations.
IRAD_ENCRYPTION_LOOKUP_KEY=
# Keep false except during an explicitly managed legacy-data migration window.
IRAD_ENCRYPTION_ALLOW_PLAINTEXT_FALLBACK=false

# Production transport security. Production defaults to HTTPS/HSTS even when
# these are omitted; set explicitly on deployed systems for clarity.
IRAD_ENFORCE_HTTPS=false
IRAD_HSTS_ENABLED=false
IRAD_HSTS_MAX_AGE=31536000
IRAD_HSTS_INCLUDE_SUBDOMAINS=true
IRAD_HSTS_PRELOAD=false

# For production use HTTPS-only, encrypted server-side sessions:
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true

# Reverse proxy / Insite Authentication Gateway.
# Keep the Laravel/PHP backend bound to loopback/private-only and list only the
# gateway source address(es) here. For a same-host gateway use 127.0.0.1,::1.
# Never use * for an Internet-facing deployment.
IRAD_TRUSTED_PROXIES=

# When users reach Insite through the gateway, these should be the external URL.
# Example development lab:
# APP_URL=https://insite.local:44350
# ASSET_URL=https://insite.local:44350
# Example production:
# APP_URL=https://insite.example.org
# ASSET_URL=https://insite.example.org
