APP_NAME=GCI_PRODUCTION_APP
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:BxmfGZm1TrqLhyvp/PCv4LXeXiqnz7OGwCCoKQwOCJw=
APP_URL=http://localhost:8000
#APP_URL=https://insite.local:44350
#ASSET_URL=https://insite.local:44350

# Local/test production authentication fallback.
# Set this to false for real production when ADFS is configured.
DEV_USER_ENABLED=true
DEV_PERSON_CODE=1111111

#
# Capture the user idenity
#

# Development Comment when in production
IRAD_IDENTITY_DRIVER=development
DEV_USER_ENABLED=true
DEV_PERSON_CODE=1111111

#IRAD_IDENTITY_DRIVER=adfs
#DEV_USER_ENABLED=false
#IRAD_ADFS_PERSON_CODE_SOURCE=HTTP_PERSON_CODE
#IRAD_TRUSTED_PROXIES=127.0.0.1,::1

# Production Comment when in development
# HTTP_PERSON_CODE is only our default placeholder. 
# Before production deployment, we'll replace it with the actual server variable 
# the ADFS/web-server team says contains IRAD's person_code claim.
# IRAD_IDENTITY_DRIVER=adfs
# IRAD_ADFS_PERSON_CODE_SOURCE=HTTP_PERSON_CODE

#
# Encryption configuration
#

# Development
IRAD_ENCRYPTION_DRIVER=laravel
IRAD_ENCRYPTION_KEY_VERSION=1
IRAD_ENCRYPTION_ALLOW_PLAINTEXT_FALLBACK=false

#Production
# IRAD_ENCRYPTION_DRIVER=laravel
# IRAD_ENCRYPTION_LOOKUP_KEY = 9fc2fbac41b19ca1d7ecd930fb057f2f5d24690c5252deb80de70b503ce106a2
# IRAD_ENCRYPTION_ALLOW_PLAINTEXT_FALLBACK=false
# IRAD_ENFORCE_HTTPS=true
# IRAD_HSTS_ENABLED=true
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@uncladcollection.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"